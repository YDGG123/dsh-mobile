.env
.env.*
!.env.example

# iOS 本地真机签名配置
/config/Local.xcconfig

# 临时构建素材（Bridge 安装包/回滚快照，不入仓库）
.bridge-artifacts/

# 本地打包产物（源码包/设计评审包，不入仓库）
/AppRelease/

# 构建产物与包（2026-11-01 补：此前 *.ipa 已忽略，但目录名与 *.apk/*.broken/*.unpublished 未覆盖）
build-output/
*.apk
*.ipa.broken
*.ipa.unpublished
# tsnet 内嵌节点：本地状态与 gomobile 生成产物（不签入，由 :androidApp:buildTsnetAar 生成）
tsnetgo/.state/
tsnetgo/*.aar
tsnetgo/*.sources.jar

# 出包交付归档（APK/IPA + DELIVERABLES.md，每版一个目录）——本机归档，不入仓库。
# 2026-11-06 补：此前无规则，主仓 releases/ 已积到 889M 且处于"未跟踪但可被 git add -A 带走"状态，
# 一次误提交就会把仓库撑爆。归档仍留在磁盘，只是不进版本控制。
/releases/
